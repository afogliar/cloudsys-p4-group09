# =============================================================================
# CloudSys P4 - Group 09 - cloud stack configuration (TEMPLATE)
#
# Copy to cloud/.env (same directory) and fill in. NEVER commit the real .env
# and never paste real values into tickets, logs or documentation. Values
# marked [SECRET] are credentials: share them only through the agreed secret
# channel and reference them by NAME elsewhere.
# =============================================================================

# Per-device bearer tokens, JSON object {meter_id: token}, one entry per
# logical meter (10 devices across the 5 edge VMs).
# [SECRET] Each token grants upload + model-download rights for its device.
DEVICE_TOKENS_JSON='{"27afc1ed":"GENERER_UN_JETON","5c3492e5":"GENERER_UN_AUTRE_JETON"}'

# Public hostname of the ingestion API. Required by compose.prod.yaml
# (Caddy + Let's Encrypt), e.g. 86-119-46-71.sslip.io. [OPEN: real DNS name]
API_HOSTNAME=

POSTGRES_DB=p4
POSTGRES_USER=p4
# [SECRET]
POSTGRES_PASSWORD=GENERER_UN_MOT_DE_PASSE

MINIO_ROOT_USER=p4admin
# [SECRET]
MINIO_ROOT_PASSWORD=GENERER_UN_MOT_DE_PASSE
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=p4-group09

# MLflow backend database inside the same PostgreSQL instance (optional;
# defaults to p4_mlflow). Used by the mlflow service and by deploy/backup.sh.
#MLFLOW_DATABASE=p4_mlflow

# --- Nuvla control plane (cloud trainer only; never on edge devices) --------
NUVLA_ENDPOINT=https://nuvla.io
# [SECRET] Dedicated trainer credential with the narrowest rollout scope.
NUVLA_API_KEY=GENERER_UN_JETON
# [SECRET]
NUVLA_API_SECRET=GENERER_UN_JETON
# Deployment group holding MODEL_VERSION_CONS / MODEL_VERSION_PROS. [OPEN]
NUVLA_DEPLOYMENT_GROUP_ID=
NUVLA_ROLLOUT_ENABLED=true
NUVLA_ROLLOUT_RETRY_SECONDS=300

# --- Read-only course inputs (host paths, override the dev defaults) --------
# Defaults assume the course repo is cloned as a SIBLING of this repo
# (../../cloudsys-p4-students-main). On a standalone cloud VM, either clone it
# at the same relative location or copy the inputs and point these at absolute
# paths, e.g. /srv/p4/kit and /srv/p4/data. Empty = use the default.
# Kit/ contents (models, p4kit, meters.json) for models-init and data-init.
P4_KIT_DIR=
# Data/ contents (meter parquet files + weather) for data-init.
P4_DATA_DIR=
# Course repo ROOT baked into the trainer image at build time (kit/ + data/).
P4_COURSE_DIR=
